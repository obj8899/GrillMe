# GrillMe — Environment Configuration Template
# Copy this file to .env for local development

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Server Configuration
HOST=127.0.0.1
PORT=8000

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# GitHub API Configuration (Optional: provides higher rate limits for public repos)
# GITHUB_TOKEN=ghp_your_token_here

# Ingestion Safety Limits
MAX_REPO_SIZE_BYTES=52428800    # 50 MB
MAX_FILE_COUNT=500              # Maximum source files processed
MAX_FILE_SIZE_BYTES=102400      # 100 KB per individual file
CHUNK_SIZE_LINES=50             # Line window for fallback chunker
CHUNK_OVERLAP_LINES=10          # Line overlap for fallback chunker
