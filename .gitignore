# ==========================================
# GrillMe — .gitignore
# ==========================================

# Virtual Environment
.venv/
venv/
ENV/
env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging & Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing, Linting & Type Checking
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# Environment Variables & Secrets (Keep .env.example tracked)
.env
.env.*
!.env.example

# Local SQLite Databases & Session Checkpoints
*.db
*.sqlite
*.sqlite3

# Temporary Cloned Repositories & Ingestion Sandbox
temp_repos/
cloned_repos/
tmp/

# Raw / Processed Corpus & Benchmark Artifacts (Protect evaluation data)
benchmarks/corpus/
benchmarks/results/
data/raw/
data/processed/

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini
